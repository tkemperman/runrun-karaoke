{
  "manifest_version": 2,
  "name": "\u30eb\u30f3\u30eb\u30f3KARAOKE",
  "version": "1.2.1",
  "description": "Editable bilingual karaoke lyrics for YouTube videos.",
  "icons": {
    "16": "src/mascot-icon-transparent-16.png",
    "32": "src/mascot-icon-transparent-32.png",
    "48": "src/mascot-icon-transparent-48.png",
    "64": "src/mascot-icon-transparent-64.png",
    "96": "src/mascot-icon-transparent-96.png",
    "128": "src/mascot-icon-transparent-128.png"
  },
  "permissions": [
    "storage",
    "https://www.youtube.com/*",
    "https://lrclib.net/*",
    "https://api.openai.com/*",
    "https://www.edrdg.org/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "scripts": [
      "src/core.js",
      "src/dictionary.js",
      "src/search.js",
      "src/providers.js",
      "src/translation.js",
      "src/repositories.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "src/mascot-icon-transparent-16.png",
      "32": "src/mascot-icon-transparent-32.png",
      "48": "src/mascot-icon-transparent-48.png"
    },
    "default_title": "\u30eb\u30f3\u30eb\u30f3KARAOKE Settings",
    "default_popup": "src/launcher.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "runrun-karaoke@silverwoodslabs",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms",
          "websiteContent",
          "authenticationInfo"
        ]
      }
    }
  },
  "options_ui": {
    "page": "src/launcher.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-karaoke": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Turn karaoke on or off in the current YouTube tab"
    }
  },
  "web_accessible_resources": [
    "src/microphone.png",
    "src/settings.html",
    "src/settings.css",
    "src/settings.js"
  ]
}
